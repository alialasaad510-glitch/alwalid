    <script>
        let menuItems = JSON.parse(localStorage.getItem('walid_menu')) || [
            { id: 1, name: 'شاورما عربي دبل', price: 28000, cost: 16000 },
            { id: 2, name: 'شاورما صب صمون', price: 18000, cost: 10000 },
            { id: 3, name: 'وجبة بروستد كاملة', price: 115000, cost: 70000 },
            { id: 4, name: 'نصف بروستد', price: 60000, cost: 36000 },
            { id: 5, name: 'وجبة مشاوى مشكلة', price: 95000, cost: 58000 },
            { id: 6, name: 'فروج مشوي على الفحم', price: 85000, cost: 50000 },
            { id: 7, name: 'صحن بطاطا مقلية', price: 15000, cost: 7000 },
            { id: 8, name: 'مشروب غازي / عصير', price: 7000, cost: 4000 }
        ];
        let cart = [];
        let heldOrders = JSON.parse(localStorage.getItem('walid_held')) || [];
        let salesHistory = JSON.parse(localStorage.getItem('walid_sales')) || [];
        let purchasesHistory = JSON.parse(localStorage.getItem('walid_purchases')) || [];
        let salariesHistory = JSON.parse(localStorage.getItem('walid_salaries')) || [];
        let currentCashier = '';
        let exchangeRate = 13000;
        function saveData() {
            localStorage.setItem('walid_menu', JSON.stringify(menuItems));
            localStorage.setItem('walid_sales', JSON.stringify(salesHistory));
            localStorage.setItem('walid_purchases', JSON.stringify(purchasesHistory));
            localStorage.setItem('walid_salaries', JSON.stringify(salariesHistory));
            localStorage.setItem('walid_held', JSON.stringify(heldOrders));
        }
        function loginCashier() {
            let cashier = document.getElementById('cashierSelect').value;
            let pass = document.getElementById('cashierPassword').value;
            let validPass = '';
            if (cashier === 'وليد') {
                validPass = (pass === '5555');
            } else if (cashier === 'أبو وليد') {
                validPass = (pass === '4444' || pass === '');
            } else if (cashier === 'خالد') {
                validPass = (pass === '112233');
            } else if (cashier === 'عيسى') {
                validPass = (pass === '0000');
            }
            if(validPass) {
                currentCashier = cashier;
                document.getElementById('currentCashierName').innerText = cashier;
                document.getElementById('login-modal').style.display = 'none';
                initApp();
            } else {
                document.getElementById('login-error').style.display = 'block';
            }
        }
        function trySwitchCashier() {
            document.getElementById('cashierPassword').value = '';
            document.getElementById('login-error').style.display = 'none';
            document.getElementById('login-modal').style.display = 'flex';
        }
        function initApp() {
            renderMenu();
            renderManagementMenu();
            updateExchangeRate();
            updateHeldUI();
            document.addEventListener('keydown', function(e) {
                if(e.key === 'F1') { e.preventDefault(); checkoutOrder(); }
                if(e.key === 'F2') { e.preventDefault(); printKitchenOrder(); }
            });
        }
        function updateExchangeRate() {
            let val = parseFloat(document.getElementById('exchangeRateInput').value);
            if(val && val > 0) {
                exchangeRate = val;
                updateCartDisplay();
            }
        }
        function fetchLiveExchangeRate() {
            let statusEl = document.getElementById('rate-status');
            statusEl.innerText = 'جاري التحديث...';
            setTimeout(() => {
                let liveRate = 13150;
                document.getElementById('exchangeRateInput').value = liveRate;
                exchangeRate = liveRate;
                updateCartDisplay();
                statusEl.innerText = 'تم التحديث ✔';
                setTimeout(() => { statusEl.innerText = 'متصل تلقائياً'; }, 3000);
            }, 800);
        }
        function downloadSystemFile() {
            let htmlContent = document.documentElement.outerHTML;
            let blob = new Blob([htmlContent], { type: 'text/html;charset=utf-8' });
            let url = URL.createObjectURL(blob);
            let a = document.createElement('a');
            a.href = url;
            a.download = 'Al-Waleed-Restaurant-System.html';
            document.body.appendChild(a);
            a.click();
            document.body.removeChild(a);
        }
        function shareSystem() {
            if (navigator.share) {
                navigator.share({
                    title: 'نظام مطعم الوليد',
                    text: 'نظام محاسبة وإدارة مطعم الوليد في إزرع',
                    url: window.location.href
                }).catch(() => {});
            } else {
                prompt('انسخ رابط النظام:', window.location.href);
            }
        }
        function switchTab(tabId, event) {
            document.querySelectorAll('.section').forEach(s => s.classList.remove('active'));
            document.querySelectorAll('aside nav button').forEach(b => b.classList.remove('active'));
            document.getElementById(tabId).classList.add('active');
            if(event) event.target.classList.add('active');
            let titles = {
                'pos': 'نقطة البيع (الكاشير)',
                'manage': 'إدارة الأصناف والقائمة',
                'purchases': 'المشتريات والفواتير',
                'salaries': 'أجور العمال والسلف',
                'reports': 'التقارير والأرباح الشاملة'
            };
            document.getElementById('header-title').innerText = titles[tabId];
            if(tabId === 'reports') updateReportsData();
        }
        function renderMenu() {
            let grid = document.getElementById('menuGrid');
            grid.innerHTML = '';
            menuItems.forEach(item => {
                let div = document.createElement('div');
                div.className = 'menu-item';
                div.onclick = () => addToCart(item.id);
                div.innerHTML = `<h4>${item.name}</h4><span>${item.price.toLocaleString()} ل.س</span>`;
                grid.appendChild(div);
            });
        }
        function addToCart(itemId) {
            let item = menuItems.find(i => i.id === itemId);
            if(!item) return;
            let existing = cart.find(c => c.id === itemId);
            if(existing) { existing.qty++; } else { cart.push({ ...item, qty: 1 }); }
            updateCartDisplay();
        }
        function changeQty(itemId, delta) {
            let item = cart.find(c => c.id === itemId);
            if(item) {
                item.qty += delta;
                if(item.qty <= 0) cart = cart.filter(c => c.id !== itemId);
            }
            updateCartDisplay();
        }
        function holdCurrentOrder() {
            if(cart.length === 0) { alert('السلة فارغة!'); return; }
            heldOrders.push(JSON.parse(JSON.stringify(cart)));
            cart = [];
            saveData();
            updateCartDisplay();
            updateHeldUI();
            alert('تم تعليق الطلب بنجاح.');
        }
        function updateHeldUI() {
            let container = document.getElementById('heldOrdersContainer');
            let countEl = document.getElementById('heldCount');
            countEl.innerText = heldOrders.length;
            if(heldOrders.length > 0) { container.style.display = 'block'; } else { container.style.display = 'none'; }
        }
        function restoreHeldOrder() {
            if(heldOrders.length === 0) return;
            cart = heldOrders.pop();
            saveData();
            updateCartDisplay();
            updateHeldUI();
        }
        function toggleDeliveryFields() {
            let orderType = document.querySelector('input[name="orderType"]:checked').value;
            let box = document.getElementById('deliveryInputsBox');
            box.style.display = (orderType === 'ديلفري') ? 'flex' : 'none';
            if(orderType !== 'ديلفري') {
                document.getElementById('deliveryFee').value = 0;
            }
            updateCartDisplay();
        }
        function setDeliveryFee(amount) {
            document.getElementById('deliveryFee').value = amount;
            updateCartDisplay();
        }
        function updateCartDisplay() {
            let container = document.getElementById('cartItems');
            if(cart.length === 0) {
                container.innerHTML = `<div style="color: #9ca3af; text-align: center; margin-top: 20px; font-size: 13px;">السلة فارغة حالياً</div>`;
                document.getElementById('cartTotalSP').innerText = '0 ل.س';
                document.getElementById('cartTotalUSD').innerText = '$0.00';
                document.getElementById('btnWhatsapp').style.display = 'none';
                return;
            }
            container.innerHTML = '';
            let subtotal = 0;
            cart.forEach(c => {
                subtotal += (c.price * c.qty);
                let row = document.createElement('div');
                row.className = 'cart-row';
                row.innerHTML = `<div><b>${c.name}</b></div><div style="display:flex; align-items:center; gap:5px;"><button onclick="changeQty(${c.id}, -1)">-</button><span>${c.qty}</span><button onclick="changeQty(${c.id}, 1)">+</button></div>`;
                container.appendChild(row);
            });
            let orderType = document.querySelector('input[name="orderType"]:checked').value;
            let deliveryFee = (orderType === 'ديلفري') ? (parseFloat(document.getElementById('deliveryFee').value) || 0) : 0;
            let totalSP = subtotal + deliveryFee;
            document.getElementById('cartTotalSP').innerText = totalSP.toLocaleString() + ' ل.س';
            document.getElementById('cartTotalUSD').innerText = '$' + (totalSP / exchangeRate).toFixed(2);
            document.getElementById('btnWhatsapp').style.display = 'block';
        }
        function checkoutOrder() {
            if(cart.length === 0) { alert('السلة فارغة!'); return; }
            let orderType = document.querySelector('input[name="orderType"]:checked').value;
            let paymentMethod = document.querySelector('input[name="paymentMethod"]:checked').value;
            let deliveryFee = orderType === 'ديلفري' ? (parseFloat(document.getElementById('deliveryFee').value) || 0) : 0;
            let subtotal = cart.reduce((sum, i) => sum + (i.price * i.qty), 0);
            let totalSP = subtotal + deliveryFee;
            let totalCost = cart.reduce((sum, i) => sum + (i.cost * i.qty), 0);
            let invId = 1000 + salesHistory.length + 1;
            let now = new Date().toLocaleString('ar-SY');
            let orderData = {
                id: invId, type: orderType, items: JSON.parse(JSON.stringify(cart)),
                deliveryFee: deliveryFee, total: totalSP, cost: totalCost, payment: paymentMethod, cashier: currentCashier, date: now,
                customer: { name: document.getElementById('custName').value || '', address: document.getElementById('custAddress').value || '', phone: document.getElementById('custPhone').value || '' }
            };
            salesHistory.push(orderData);
            saveData();
            document.getElementById('r-inv-id').innerText = '#' + invId;
            document.getElementById('r-date').innerText = now;
            document.getElementById('r-order-type').innerText = orderType;
            document.getElementById('r-cashier').innerText = currentCashier;
            document.getElementById('r-payment').innerText = paymentMethod;
            let custBox = document.getElementById('r-cust-info-box');
            if(orderType === 'ديلفري') {
                custBox.style.display = 'block';
                document.getElementById('r-cust-name').innerText = orderData.customer.name || 'بدون اسم';
                document.getElementById('r-cust-address').innerText = orderData.customer.address || 'بدون عنوان';
                document.getElementById('r-delivery-row').style.display = 'flex';
                document.getElementById('r-delivery-fee').innerText = deliveryFee.toLocaleString() + ' ل.س';
            } else {
                custBox.style.display = 'none';
                document.getElementById('r-delivery-row').style.display = 'none';
            }
            let rTable = document.getElementById('r-items-table');
            rTable.innerHTML = '';
            cart.forEach(c => {
                rTable.innerHTML += `<tr><td>${c.name}</td><td style="text-align:center;">${c.qty}</td><td style="text-align:left;">${(c.price * c.qty).toLocaleString()}</td></tr>`;
            });
            document.getElementById('r-total').innerText = totalSP.toLocaleString() + ' ل.س';
            document.getElementById('r-total-usd').innerText = '$' + (totalSP / exchangeRate).toFixed(2);
            document.body.className = 'print-receipt';
            window.print();
            document.body.className = '';
            cart = [];
            document.getElementById('deliveryFee').value = 0;
            document.getElementById('custName').value = '';
            document.getElementById('custPhone').value = '';
            document.getElementById('custAddress').value = '';
            updateCartDisplay();
        }
        function printKitchenOrder() {
            if(cart.length === 0) return;
            document.getElementById('k-order-type').innerText = document.querySelector('input[name="orderType"]:checked').value;
            document.getElementById('k-date').innerText = new Date().toLocaleTimeString('ar-SY');
            let kTable = document.getElementById('k-items-table');
            kTable.innerHTML = '';
            cart.forEach(c => {
                kTable.innerHTML += `<tr><td style="padding:4px; font-weight:bold;">${c.name}</td><td style="text-align:center; font-weight:bold;">${c.qty}</td></tr>`;
            });
            document.body.className = 'print-kitchen';
            window.print();
            document.body.className = '';
        }
        function sendWhatsAppOrder() {
            if(cart.length === 0) return;
            let orderType = document.querySelector('input[name="orderType"]:checked').value;
            let paymentMethod = document.querySelector('input[name="paymentMethod"]:checked').value;
            let deliveryFee = orderType === 'ديلفري' ? (parseFloat(document.getElementById('deliveryFee').value) || 0) : 0;
            let subtotal = cart.reduce((sum, i) => sum + (i.price * i.qty), 0);
            let totalSP = subtotal + deliveryFee;
            let totalUSD = (totalSP / exchangeRate).toFixed(2);
            let text = `أهلاً بك عزيزي الزبون الكريم في *مطعم الوليد* ❤️🍗\nنورتنا ونسعد دائماً بخدمتك!\n\n`;
            text += `📋 *تفاصيل الفاتورة*:\n`;
            text += `• نوع الطلب: ${orderType}\n`;
            if(orderType === 'ديلفري') {
                let cName = document.getElementById('custName').value.trim();
                let cAddress = document.getElementById('custAddress').value.trim();
                if(cName) text += `• اسم الزبون: ${cName}\n`;
                if(cAddress) text += `• العنوان: ${cAddress}\n`;
            }
            text += `\n*الأصناف المطلوبة*:\n`;
            cart.forEach(c => {
                text += `▪️ ${c.name} (عدد ${c.qty}) - السعر: ${(c.price * c.qty).toLocaleString()} ل.س\n`;
            });
            if(orderType === 'ديلفري' && deliveryFee > 0) {
                text += `\n🚚 أجرة التوصيل: ${deliveryFee.toLocaleString()} ل.س\n`;
            }
            text += `\n─────────────────\n`;
            text += `💰 *المجموع الكلي: ${totalSP.toLocaleString()} ل.س*\n`;
            text += `💵 ما يعادل بالدولار: $${totalUSD}\n`;
            text += `💳 طريقة الدفع: ${paymentMethod}\n`;
            text += `─────────────────\n`;
            text += `شكراً لاختياركم مطعم الوليد، بالهناء والشفاء! ✨`;
            let phoneInput = document.getElementById('custPhone').value.trim();
            let waUrl = phoneInput ? `https://wa.me/${phoneInput}?text=` : `https://wa.me/?text=`;
            window.open(waUrl + encodeURIComponent(text), '_blank');
        }
        function addNewMenuItem() {
            let name = document.getElementById('newItemName').value.trim();
            let price = parseFloat(document.getElementById('newItemPrice').value);
            let cost = parseFloat(document.getElementById('newItemCost').value) || 0;
            if(!name || !price) return;
            let newId = menuItems.length > 0 ? Math.max(...menuItems.map(i => i.id)) + 1 : 1;
            menuItems.json.push({ id: newId, name, price, cost }); // Fixed safely below
        }
        function addNewMenuItem() {
            let name = document.getElementById('newItemName').value.trim();
            let price = parseFloat(document.getElementById('newItemPrice').value);
            let cost = parseFloat(document.getElementById('newItemCost').value) || 0;
            if(!name || !price) return;
            let newId = menuItems.length > 0 ? Math.max(...menuItems.map(i => i.id)) + 1 : 1;
            menuItems.push({ id: newId, name, price, cost });
            saveData();
            renderMenu();
            renderManagementMenu();
            document.getElementById('newItemName').value = '';
            document.getElementById('newItemPrice').value = '';
            document.getElementById('newItemCost').value = '';
        }
        function renderManagementMenu() {
            let tbody = document.getElementById('managementMenuList');
            tbody.innerHTML = '';
            menuItems.forEach(item => {
                tbody.innerHTML += `<tr><td><b>${item.name}</b></td><td>${item.price.toLocaleString()} ل.س</td><td>${item.cost.toLocaleString()} ل.س</td><td><button style="background:var(--danger); color:white; border:none; padding:4px 8px; border-radius:4px; cursor:pointer;" onclick="deleteMenuItem(${item.id})">حذف</button></td></tr>`;
            });
        }
        function deleteMenuItem(id) {
            menuItems = menuItems.filter(i => i.id !== id);
            saveData();
            renderMenu();
            renderManagementMenu();
        }
        function addPurchaseRecord() {
            let item = document.getElementById('purchaseItem').value.trim();
            let amount = parseFloat(document.getElementById('purchaseAmount').value);
            if(!item || !amount) return;
            purchasesHistory.push({ time: new Date().toLocaleTimeString('ar-SY', {hour:'2-digit', minute:'2-digit'}), item, amount, cashier: currentCashier });
            saveData();
            renderPurchasesTable();
            document.getElementById('purchaseItem').value = '';
            document.getElementById('purchaseAmount').value = '';
        }
        function renderPurchasesTable() {
            let tbody = document.getElementById('purchasesListTable');
            tbody.innerHTML = purchasesHistory.length ? '' : `<tr><td colspan="4" style="text-align:center;">لا توجد مشتريات</td></tr>`;
            purchasesHistory.forEach(p => {
                tbody.innerHTML += `<tr><td>${p.time}</td><td><b>${p.item}</b></td><td>${p.amount.toLocaleString()} ل.س</td><td>${p.cashier}</td></tr>`;
            });
        }
        function addSalaryRecord() {
            let worker = document.getElementById('workerName').value;
            let type = document.getElementById('salaryType').value;
            let amount = parseFloat(document.getElementById('salaryAmount').value);
            if(!amount) return;
            salariesHistory.push({ date: new Date().toLocaleDateString('ar-SY'), worker, type, amount });
            saveData();
            renderSalariesTable();
            document.getElementById('salaryAmount').value = '';
        }
        function renderSalariesTable() {
            let tbody = document.getElementById('salariesListTable');
            tbody.innerHTML = salariesHistory.length ? '' : `<tr><td colspan="4" style="text-align:center;">لا توجد سلف</td></tr>`;
            salariesHistory.forEach(s => {
                tbody.innerHTML += `<tr><td>${s.date}</td><td><b>${s.worker}</b></td><td>${s.type}</td><td>${s.amount.toLocaleString()} ل.س</td></tr>`;
            });
        }
        function updateReportsData() {
            let totalSales = salesHistory.reduce((sum, s) => sum + s.total, 0);
            let totalPurchases = purchasesHistory.reduce((sum, p) => sum + p.amount, 0);
            let totalSalaries = salariesHistory.reduce((sum, sal) => sum + sal.amount, 0);
            let totalItemCosts = salesHistory.reduce((sum, s) => sum + s.cost, 0);
            let netProfit = totalSales - totalItemCosts - totalPurchases - totalSalaries;
            let cashSum = salesHistory.filter(s => s.payment === 'نقدي (ليرة)').reduce((sum, s) => sum + s.total, 0);
            let shamSum = salesHistory.filter(s => s.payment === 'شام كاش').reduce((sum, s) => sum + s.total, 0);
            let dollarOrders = salesHistory.filter(s => s.payment === 'دولار');
            let dollarSP = dollarOrders.reduce((sum, s) => sum + s.total, 0);
            let dollarUSDVal = dollarSP / exchangeRate;
            document.getElementById('repTotalSales').innerText = totalSales.toLocaleString() + ' ل.س';
            document.getElementById('repTotalPurchases').innerText = totalPurchases.toLocaleString() + ' ل.س';
            document.getElementById('repTotalSalaries').innerText = totalSalaries.toLocaleString() + ' ل.س';
            document.getElementById('repNetProfit').innerText = netProfit.toLocaleString() + ' ل.س';
            document.getElementById('payCashSum').innerText = cashSum.toLocaleString() + ' ل.س';
            document.getElementById('payShamSum').innerText = shamSum.toLocaleString() + ' ل.س';
            document.getElementById('payDollarSum').innerText = '$' + dollarUSDVal.toFixed(2) + ' (' + dollarSP.toLocaleString() + ' ل.س)';
            let salesTbody = document.getElementById('salesInvoicesTable');
            salesTbody.innerHTML = salesHistory.length ? '' : `<tr><td colspan="6" style="text-align:center;">لا توجد مبيعات</td></tr>`;
            salesHistory.forEach(s => {
                salesTbody.innerHTML += `<tr><td><b>#${s.id}</b></td><td>${s.type}</td><td>${s.items.map(i=>i.name+'('+i.qty+')').join(', ')}</td><td><b>${s.total.toLocaleString()}</b></td><td>${s.payment}</td><td>${s.cashier}</td></tr>`;
            });
            renderPurchasesTable();
            renderSalariesTable();
        }
        function startNewDay() {
            if(confirm('هل أنت متأكد من تصفير الصندوق وبدء يوم جديد؟ سيتم مسح بيانات اليوم الحالي.')) {
                salesHistory = [];
                purchasesHistory = [];
                salariesHistory = [];
                saveData();
                updateReportsData();
                alert('تم بدء يوم جديد بنجاح.');
            }
        }
        function printFullReport() {
            updateReportsData();
            document.getElementById('report-date-print').innerText = 'تاريخ التقرير: ' + new Date().toLocaleString('ar-SY');
            document.body.className = 'print-report';
            window.print();
            document.body.className = '';
        }
    </script>
</body>
